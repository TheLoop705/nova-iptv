{
  "name": "nova-iptv",
  "version": "1.7.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-modules-core": "~57.0.19",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "hls.js": "^1.7.3",
    "idb-keyval": "^6.3.0",
    "mpegts.js": "^1.8.2",
    "pako": "^3.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "node scripts/start-web.mjs",
    "proxy": "node server/index.mjs",
    "mock:xtream": "node server/mock-xtream.mjs",
    "build:web": "expo export -p web && node scripts/write-web-version.mjs && node scripts/compress-dist.mjs",
    "serve": "node server/index.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "windows": "npm --prefix desktop start",
    "build:windows": "npm --prefix desktop run dist",
    "test:windows": "npm --prefix desktop run smoke",
    "typecheck": "tsc --noEmit",
    "test:updates": "node --test tests/updates.test.mjs",
    "build:perf:web": "node scripts/build-performance-web.mjs",
    "test:performance": "node --import tsx --test tests/*performance.test.mjs tests/mock-xtream.test.mjs tests/test-env.test.mjs",
    "test:e2e": "playwright test",
    "test:provider": "node scripts/provider-smoke.mjs",
    "test:android:smoke": "node scripts/android-smoke.mjs",
    "test:android:doctor": "node scripts/android-smoke.mjs --doctor",
    "mock:stress": "node scripts/start-stress-mock.mjs",
    "test:perf:windows": "node scripts/test-windows-performance.mjs",
    "test:ios:smoke": "node scripts/ios-smoke.mjs"
  },
  "private": true
}
