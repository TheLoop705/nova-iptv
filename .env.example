# Optional real-provider checks. Copy to .env; keep credentials out of EXPO_PUBLIC_*.
# These names are read only by Node test scripts, never by the client bundle.
NOVA_TEST_SERVER=https://your-provider.example:443
NOVA_TEST_USERNAME=
NOVA_TEST_PASSWORD=
# Optional overrides (an EPG URL may itself contain credentials).
NOVA_TEST_EPG_URL=
NOVA_TEST_USER_AGENT=
# Per-request body+headers deadline, and maximum guide transfer before failure.
NOVA_TEST_TIMEOUT_MS=120000
NOVA_TEST_MAX_GUIDE_MB=128
# Real-provider browser tests run only when this explicit flag is set.
NOVA_TEST_PROVIDER=0
# Android / Fire TV: optional device serial, APK and adb executable.
NOVA_TEST_ANDROID_SERIAL=
NOVA_TEST_APK=
NOVA_TEST_ADB=
